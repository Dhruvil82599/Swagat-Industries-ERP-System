// Swagat Industries ERP - Prisma Schema
// PostgreSQL Database Schema for Swagat ERP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. CUSTOMERS
model Customer {
  id           Int         @id @default(autoincrement())
  customerName String      @map("customer_name") @db.VarChar(255)
  mobileNumber String      @map("mobile_number") @db.VarChar(15)
  address      String      @db.Text
  gstNo        String?     @map("gst_no") @db.VarChar(20)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  industries   Industry[]
  quotations   Quotation[]

  @@index([customerName])
  @@index([mobileNumber])
  @@map("customers")
}

// 2. INDUSTRIES / COMPANIES
model Industry {
  id            Int         @id @default(autoincrement())
  customerId    Int         @map("customer_id")
  industryName  String      @map("industry_name") @db.VarChar(255)
  gstNo         String?     @map("gst_no") @db.VarChar(20)
  address       String      @db.Text
  contactPerson String?     @map("contact_person") @db.VarChar(150)
  mobileNo      String?     @map("mobile_no") @db.VarChar(15)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sites         Site[]
  quotations    Quotation[]

  @@index([customerId])
  @@index([industryName])
  @@map("industries")
}

// 3. SITES / LOCATIONS
model Site {
  id            Int         @id @default(autoincrement())
  industryId    Int         @map("industry_id")
  siteName      String      @map("site_name") @db.VarChar(255)
  siteAddress   String      @map("site_address") @db.Text
  cityLocation  String      @map("city_location") @db.VarChar(150)
  contactPerson String?     @map("contact_person") @db.VarChar(150)
  mobileNo      String?     @map("mobile_no") @db.VarChar(15)
  remark        String?     @db.Text
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  industry      Industry    @relation(fields: [industryId], references: [id], onDelete: Cascade)
  shutters      Shutter[]
  quotations    Quotation[]

  @@index([industryId])
  @@index([siteName])
  @@map("sites")
}

// 4. SHUTTERS (Master Catalog per Site)
model Shutter {
  id                    Int             @id @default(autoincrement())
  siteId                Int             @map("site_id")
  shutterNameNo         String          @map("shutter_name_no") @db.VarChar(150)
  heightInches          Decimal         @map("height_inches") @db.Decimal(10, 2)
  widthInches           Decimal         @map("width_inches") @db.Decimal(10, 2)
  shutterType           String          @map("shutter_type") @db.VarChar(50) // Manual, Gear, Motorised
  fittingType           String          @map("fitting_type") @db.VarChar(50) // A Type, B Type
  ratePerSqft           Decimal         @default(0) @map("rate_per_sqft") @db.Decimal(12, 2)
  giTopCoverRatePerSqft Decimal         @default(0) @map("gi_top_cover_rate_per_sqft") @db.Decimal(12, 2)
  gearPrice             Decimal         @default(0) @map("gear_price") @db.Decimal(12, 2)
  motorPrice            Decimal         @default(0) @map("motor_price") @db.Decimal(12, 2)
  gstApplicable         Boolean         @default(true) @map("gst_applicable")
  remark                String?         @db.Text
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  site                  Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  quotationItems        QuotationItem[]

  @@index([siteId])
  @@map("shutters")
}

// 5. QUOTATIONS (Header & Quotation-level Charges)
model Quotation {
  id                     Int                @id @default(autoincrement())
  quotationNo            String             @unique @map("quotation_no") @db.VarChar(50)
  quotationDate          DateTime           @default(now()) @map("quotation_date")
  customerId             Int                @map("customer_id")
  industryId             Int?               @map("industry_id")
  siteId                 Int?               @map("site_id")

  // Quotation-level Financial Calculation Summary
  shutterBasicTotal      Decimal            @default(0) @map("shutter_basic_total") @db.Decimal(12, 2)
  giTopCoverTotal        Decimal            @default(0) @map("gi_top_cover_total") @db.Decimal(12, 2)
  transportationCharges  Decimal            @default(0) @map("transportation_charges") @db.Decimal(12, 2)
  additionalChargesTotal Decimal            @default(0) @map("additional_charges_total") @db.Decimal(12, 2)
  discountAmount         Decimal            @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountReason         String?            @map("discount_reason") @db.VarChar(255)
  totalBasic             Decimal            @default(0) @map("total_basic") @db.Decimal(12, 2)
  gstApplicable          Boolean            @default(true) @map("gst_applicable")
  gstPercent             Decimal            @default(18.00) @map("gst_percent") @db.Decimal(5, 2)
  gstAmount              Decimal            @default(0) @map("gst_amount") @db.Decimal(12, 2)
  finalTotal             Decimal            @default(0) @map("final_total") @db.Decimal(12, 2)

  remark                 String?            @db.Text
  companyDetails         Json?              @map("company_details")
  quotationTerms         Json?              @map("quotation_terms")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  customer               Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  industry               Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  site                   Site?              @relation(fields: [siteId], references: [id], onDelete: SetNull)
  items                  QuotationItem[]
  additionalCharges      AdditionalCharge[]
  payments               Payment[]

  @@index([quotationNo])
  @@index([quotationDate])
  @@index([customerId])
  @@index([industryId])
  @@index([siteId])
  @@map("quotations")
}

// 6. QUOTATION ITEMS (Independent Snapshot of Shutter Values per Quotation)
model QuotationItem {
  id                    Int        @id @default(autoincrement())
  quotationId           Int        @map("quotation_id")
  shutterId             Int?       @map("shutter_id")
  srNo                  Int        @map("sr_no")
  shutterNameNo         String?    @map("shutter_name_no") @db.VarChar(150)

  // Dimensions (inches & converted feet)
  heightInches          Decimal    @map("height_inches") @db.Decimal(10, 2)
  widthInches           Decimal    @map("width_inches") @db.Decimal(10, 2)
  heightFt              Decimal    @map("height_ft") @db.Decimal(10, 2)
  widthFt               Decimal    @map("width_ft") @db.Decimal(10, 2)
  shutterType           String     @map("shutter_type") @db.VarChar(50) // Manual, Gear, Motorised
  fittingType           String     @map("fitting_type") @db.VarChar(50) // A Type, B Type
  overHeight            Decimal    @map("over_height") @db.Decimal(10, 2)
  overWidth             Decimal    @map("over_width") @db.Decimal(10, 2)
  totalSqft             Decimal    @map("total_sqft") @db.Decimal(10, 2)
  coverSize             Decimal    @map("cover_size") @db.Decimal(10, 2) // GI Top Cover R. Ft

  // Rates and prices
  ratePerSqft           Decimal    @default(0) @map("rate_per_sqft") @db.Decimal(12, 2)
  giTopCoverRatePerSqft Decimal    @default(0) @map("gi_top_cover_rate_per_sqft") @db.Decimal(12, 2)
  gearPrice             Decimal    @default(0) @map("gear_price") @db.Decimal(12, 2)
  motorPrice            Decimal    @default(0) @map("motor_price") @db.Decimal(12, 2)

  // Calculated financial totals for item
  shutterBasic          Decimal    @default(0) @map("shutter_basic") @db.Decimal(12, 2)
  giTopCoverBasic       Decimal    @default(0) @map("gi_top_cover_basic") @db.Decimal(12, 2)
  basicTotal            Decimal    @default(0) @map("basic_total") @db.Decimal(12, 2)

  gstApplicable         Boolean    @default(true) @map("gst_applicable")
  remark                String?    @db.Text
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  quotation             Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  shutter               Shutter?   @relation(fields: [shutterId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([shutterId])
  @@map("quotation_items")
}

// 7. ADDITIONAL CHARGES (Optional quotation-level charges)
model AdditionalCharge {
  id          Int       @id @default(autoincrement())
  quotationId Int       @map("quotation_id")
  description String    @db.VarChar(255)
  amount      Decimal   @db.Decimal(12, 2)
  chargeType  String    @default("Quotation-wise") @map("charge_type") @db.VarChar(50) // Shutter-wise or Quotation-wise
  remark      String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("additional_charges")
}

// 8. PAYMENTS (Quotations payments tracking)
model Payment {
  id            Int       @id @default(autoincrement())
  quotationId   Int       @map("quotation_id")
  paymentDate   DateTime  @default(now()) @map("payment_date")
  paymentAmount Decimal   @map("payment_amount") @db.Decimal(12, 2)
  paymentMethod String    @map("payment_method") @db.VarChar(50) // Cash, Google Pay, UPI, Cheque
  transactionNo String?   @map("transaction_no") @db.VarChar(100)
  chequeNo      String?   @map("cheque_no") @db.VarChar(100)
  chequeDate    DateTime? @map("cheque_date")
  bankName      String?   @map("bank_name") @db.VarChar(100)
  remark        String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  quotation     Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([paymentDate])
  @@map("payments")
}

// 9. COMPANY SETTINGS (Swagat Industries Configuration)
model CompanySetting {
  id               Int      @id @default(autoincrement())
  companyName      String   @default("Swagat Industries") @map("company_name") @db.VarChar(255)
  logoUrl          String?  @map("logo_url") @db.Text
  address          String?  @db.Text
  cityStatePincode String?  @map("city_state_pincode") @db.VarChar(255)
  mobile           String?  @db.VarChar(50)
  altMobile        String?  @map("alt_mobile") @db.VarChar(50)
  email            String?  @db.VarChar(100)
  website          String?  @db.VarChar(100)
  gstNo            String?  @map("gst_no") @db.VarChar(50)
  panNo            String?  @map("pan_no") @db.VarChar(50)
  bankName         String?  @map("bank_name") @db.VarChar(100)
  accountNo        String?  @map("account_no") @db.VarChar(50)
  ifscCode         String?  @map("ifsc_code") @db.VarChar(50)
  branchName       String?  @map("branch_name") @db.VarChar(100)
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

// 10. QUOTATION TERMS (Configurable terms & conditions for PDF)
model QuotationTerm {
  id           Int      @id @default(autoincrement())
  termKey      String?  @map("term_key") @db.VarChar(100)
  termTitle    String   @map("term_title") @db.VarChar(255)
  termText     String   @map("term_text") @db.Text
  displayOrder Int      @default(1) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([displayOrder])
  @@map("quotation_terms")
}

// 11. USERS (Admin / Authentication Users)
model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique @db.VarChar(100)
  email           String?   @unique @db.VarChar(150)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String?   @map("full_name") @db.VarChar(150)
  role            String    @default("ADMIN") @db.VarChar(50)
  resetOtp        String?   @map("reset_otp") @db.VarChar(10)
  resetOtpExpires DateTime? @map("reset_otp_expires")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([username])
  @@index([email])
  @@map("users")
}

// 12. USER INVITATIONS (Pending email invitations for new users)
model UserInvitation {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(150)
  fullName  String?  @map("full_name") @db.VarChar(150)
  code      String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([code])
  @@map("user_invitations")
}

// 13. EMPLOYEES (Employee Master)
model Employee {
  id               Int       @id @default(autoincrement())
  employeeCode     String    @unique @map("employee_code") @db.VarChar(50)
  fullName         String    @map("full_name") @db.VarChar(200)
  mobileNumber     String    @map("mobile_number") @db.VarChar(15)
  email            String?   @db.VarChar(150)
  department       String?   @db.VarChar(100)
  joiningDate      DateTime? @map("joining_date")
  address          String?   @db.Text
  city             String?   @db.VarChar(100)
  emergencyContact String?   @map("emergency_contact") @db.VarChar(15)
  photoUrl         String?   @map("photo_url") @db.Text
  // Salary Configuration Master Fields
  baseSalary       Decimal   @default(0.00) @map("base_salary") @db.Decimal(12, 2)
  salaryType       String    @default("MONTHLY") @map("salary_type") @db.VarChar(50) // MONTHLY, DAILY
  overtimeRate     Decimal   @default(0.00) @map("overtime_rate") @db.Decimal(10, 2)

  isActive         Boolean   @default(true) @map("is_active")
  remark           String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  attendances      EmployeeAttendance[]
  advances         EmployeeAdvance[]
  salaries         EmployeeSalary[]
  salaryPayments   EmployeeSalaryPayment[]

  @@index([employeeCode])
  @@index([fullName])
  @@index([mobileNumber])
  @@index([isActive])
  @@map("employees")
}

// 14. EMPLOYEE ATTENDANCE (Daily Employee Attendance Management)
model EmployeeAttendance {
  id             Int               @id @default(autoincrement())
  employeeId     Int               @map("employee_id")
  attendanceDate DateTime          @map("attendance_date") @db.Date
  status         String            @db.VarChar(50) // PRESENT, ABSENT, HALF DAY, LEAVE, HOLIDAY
  checkIn        String?           @map("check_in") @db.VarChar(10) // e.g. "09:00"
  checkOut       String?           @map("check_out") @db.VarChar(10) // e.g. "18:00"
  regularHours   Decimal           @default(9.00) @map("regular_hours") @db.Decimal(5, 2)
  overtimeHours  Decimal           @default(0.00) @map("overtime_hours") @db.Decimal(5, 2)
  advanceAmount  Decimal           @default(0.00) @map("advance_amount") @db.Decimal(12, 2)
  remarks        String?           @db.Text
  createdBy      String?           @map("created_by") @db.VarChar(100)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedBy      String?           @map("updated_by") @db.VarChar(100)
  updatedAt      DateTime          @updatedAt @map("updated_at")

  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  advances       EmployeeAdvance[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@index([employeeId])
  @@index([status])
  @@map("employee_attendance")
}

// 15. EMPLOYEE ADVANCE / UPAD (Advances linked with Daily Attendance)
model EmployeeAdvance {
  id           Int                 @id @default(autoincrement())
  employeeId   Int                 @map("employee_id")
  attendanceId Int?                @map("attendance_id")
  advanceDate  DateTime            @map("advance_date") @db.Date
  amount       Decimal             @map("amount") @db.Decimal(12, 2)
  paymentMode  String              @default("CASH") @map("payment_mode") @db.VarChar(50)
  reason       String?             @db.VarChar(255)
  remarks      String?             @db.Text
  createdBy    String?             @map("created_by") @db.VarChar(100)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedBy    String?             @map("updated_by") @db.VarChar(100)
  updatedAt    DateTime            @updatedAt @map("updated_at")

  employee     Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance   EmployeeAttendance? @relation(fields: [attendanceId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([advanceDate])
  @@index([attendanceId])
  @@map("employee_advances")
}

// 16. EMPLOYEE SALARY (Monthly Salary Calculation & Payslip Ledger)
model EmployeeSalary {
  id               Int      @id @default(autoincrement())
  employeeId       Int      @map("employee_id")
  month            Int      @db.SmallInt // 1 to 12
  year             Int      @db.SmallInt // e.g. 2026
  salaryType       String   @default("MONTHLY") @map("salary_type") @db.VarChar(50) // MONTHLY, DAILY
  baseSalary       Decimal  @default(0.00) @map("base_salary") @db.Decimal(12, 2)
  dailyRate        Decimal  @default(0.00) @map("daily_rate") @db.Decimal(12, 2)
  totalDaysInMonth Int      @default(30) @map("total_days_in_month")
  presentDays      Decimal  @default(0.00) @map("present_days") @db.Decimal(5, 2)
  halfDays         Int      @default(0) @map("half_days")
  absentDays       Decimal  @default(0.00) @map("absent_days") @db.Decimal(5, 2)
  leaveDays        Decimal  @default(0.00) @map("leave_days") @db.Decimal(5, 2)
  holidayDays      Decimal  @default(0.00) @map("holiday_days") @db.Decimal(5, 2)
  payableDays      Decimal  @default(0.00) @map("payable_days") @db.Decimal(5, 2)
  earnedBasic      Decimal  @default(0.00) @map("earned_basic") @db.Decimal(12, 2)
  overtimeHours    Decimal  @default(0.00) @map("overtime_hours") @db.Decimal(8, 2)
  overtimeRate     Decimal  @default(0.00) @map("overtime_rate") @db.Decimal(10, 2)
  overtimeAmount   Decimal  @default(0.00) @map("overtime_amount") @db.Decimal(12, 2)
  grossSalary      Decimal  @default(0.00) @map("gross_salary") @db.Decimal(12, 2)
  advanceDeduction Decimal  @default(0.00) @map("advance_deduction") @db.Decimal(12, 2)
  totalDeductions  Decimal  @default(0.00) @map("total_deductions") @db.Decimal(12, 2)
  netSalary        Decimal  @default(0.00) @map("net_salary") @db.Decimal(12, 2)
  status           String   @default("GENERATED") @db.VarChar(50) // DRAFT, GENERATED, APPROVED, PAID
  remarks          String?  @db.Text
  createdBy        String?  @map("created_by") @db.VarChar(100)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedBy        String?  @map("updated_by") @db.VarChar(100)
  updatedAt        DateTime @updatedAt @map("updated_at")

  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payments         EmployeeSalaryPayment[]

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([month, year])
  @@index([status])
  @@map("employee_salaries")
}

// 17. EMPLOYEE SALARY PAYMENT (Phase 7: Installments & Payment Tracking)
model EmployeeSalaryPayment {
  id              Int            @id @default(autoincrement())
  salaryId        Int            @map("salary_id")
  employeeId      Int            @map("employee_id")
  paymentDate     DateTime       @default(now()) @map("payment_date") @db.Date
  amount          Decimal        @map("amount") @db.Decimal(12, 2)
  paymentMode     String         @default("CASH") @map("payment_mode") @db.VarChar(50) // CASH, BANK, UPI, CHEQUE, OTHER
  referenceNumber String?        @map("reference_number") @db.VarChar(100)
  remarks         String?        @db.Text
  createdBy       String?        @map("created_by") @db.VarChar(100)
  createdAt       DateTime       @default(now()) @map("created_at")

  salary          EmployeeSalary @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([salaryId])
  @@index([employeeId])
  @@index([paymentDate])
  @@map("employee_salary_payments")
}




